# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ── Lead form delivery (at least one is required in production) ─────────
# Google Sheet: paste the Apps Script web app URL (…/exec). Setup steps are at
# the top of scripts/google-sheet-apps-script.gs.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx0XfYFrAvo1f4GRTo0GKpaKv2_ChgX8Z9msaGjS5y7HcGvyiTXdvG8576kUc3J02Yl/exec
GOOGLE_SHEET_SECRET=27fece88656b3c0538ef4f77ec6f710e67b3c37633760ce07e1389d671ac2896
# Resend (https://resend.com) — verify proshala.com as a sending domain first.
RESEND_API_KEY=
LEAD_EMAIL_FROM="Proshala Website <leads@proshala.com>"
# Comma-separated list of recipients
LEAD_EMAIL_TO=contact@proshala.com
# Optional: JSON POST of every lead (Google Apps Script web app for a Sheet,
# Zapier/Make/n8n webhook, or your CRM)
LEAD_WEBHOOK_URL=

# ── Analytics & ads (all optional, all consent-aware) ───────────────────
# The previous site used GA4 G-FCHC0XD63Q. Use EITHER GA_ID directly OR
# configure GA4 inside GTM — not both, or pageviews are counted twice.
NEXT_PUBLIC_GA_ID=G-FCHC0XD63Q
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Search Console ──────────────────────────────────────────────────────
# The content value of the google-site-verification meta tag (or verify via DNS instead)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Content preview ─────────────────────────────────────────────────────
# Set to "true" on a preview deployment to show TODO placeholders in production builds
NEXT_PUBLIC_SHOW_TODOS=
